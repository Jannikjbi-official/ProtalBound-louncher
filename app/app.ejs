<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <style>
        body {
            /*background: url('assets/images/backgrounds/<%=bkid%>.jpg') no-repeat center center fixed;*/
            background-color: #050609;
            transition: background-image 1s ease;
            background-image: url('data:image/jpeg;base64,');
            background-size: cover;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            background: linear-gradient(to top, rgba(5, 6, 9, 0.85) 0%, rgba(5, 6, 9, 0) 100%);
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body bkid="<%=bkid%>">
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="changelogModal" style="display: none;">
        <div id="changelogCard">
            <div id="changelogHeader">
                <img id="changelogLogo" src="assets/images/portalbound-mark.png"/>
                <div id="changelogHeading">
                    <span id="changelogEyebrow"></span>
                    <span id="changelogTitle"></span>
                </div>
                <button id="changelogClose">&#10005;</button>
            </div>
            <div id="changelogBody"></div>
            <div id="changelogActions">
                <button id="changelogDone"></button>
            </div>
        </div>
    </div>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <div id="loadSpinnerImage" class="rotating"></div>
                <img id="loadCenterImage" src="assets/images/portalbound-mark.png">
            </div>
        </div>
    </div>
</body>
</html>